{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: FastAPI (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "Benchmark (quick)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/benchmarks/benchmark.py",
      "args": ["--quick"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Frontend: open in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/src"
    }
  ]
}
