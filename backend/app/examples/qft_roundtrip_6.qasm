OPENQASM 2.0;
include "qelib1.inc";
// Prepare |101101>, apply the QFT, then the inverse QFT.
// Ideal output is the input bitstring; noise blurs it.
qreg q[6];
creg c[6];
x q[0];
x q[2];
x q[3];
x q[5];
// QFT
h q[0];
cp(1.570796326795) q[1],q[0];
cp(0.785398163397) q[2],q[0];
cp(0.392699081699) q[3],q[0];
cp(0.196349540849) q[4],q[0];
cp(0.098174770425) q[5],q[0];
h q[1];
cp(1.570796326795) q[2],q[1];
cp(0.785398163397) q[3],q[1];
cp(0.392699081699) q[4],q[1];
cp(0.196349540849) q[5],q[1];
h q[2];
cp(1.570796326795) q[3],q[2];
cp(0.785398163397) q[4],q[2];
cp(0.392699081699) q[5],q[2];
h q[3];
cp(1.570796326795) q[4],q[3];
cp(0.785398163397) q[5],q[3];
h q[4];
cp(1.570796326795) q[5],q[4];
h q[5];
swap q[0],q[5];
swap q[1],q[4];
swap q[2],q[3];
// inverse QFT
swap q[2],q[3];
swap q[1],q[4];
swap q[0],q[5];
h q[5];
cp(-1.570796326795) q[5],q[4];
h q[4];
cp(-0.785398163397) q[5],q[3];
cp(-1.570796326795) q[4],q[3];
h q[3];
cp(-0.392699081699) q[5],q[2];
cp(-0.785398163397) q[4],q[2];
cp(-1.570796326795) q[3],q[2];
h q[2];
cp(-0.196349540849) q[5],q[1];
cp(-0.392699081699) q[4],q[1];
cp(-0.785398163397) q[3],q[1];
cp(-1.570796326795) q[2],q[1];
h q[1];
cp(-0.098174770425) q[5],q[0];
cp(-0.196349540849) q[4],q[0];
cp(-0.392699081699) q[3],q[0];
cp(-0.785398163397) q[2],q[0];
cp(-1.570796326795) q[1],q[0];
h q[0];
measure q -> c;
