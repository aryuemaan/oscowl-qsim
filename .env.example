# Copy this file to `.env` (same folder) and fill in what you have.
# Everything is optional: with no key the app runs in "offline" AI mode
# (rule-based explanations, deterministic fixes) so the demo always works.

# --- Gemini API (get a key at https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=

# auto = use Gemini when a key is set, otherwise offline. Or force: gemini | offline
QSIM_AI_MODE=auto

# Model IDs (check the current list in Google AI Studio or https://ai.google.dev/gemini-api/docs/models)
GEMINI_FLASH_MODEL=gemini-3.8-flash
GEMINI_REASONING_MODEL=gemini-4-argon

# --- Gemma pre-check ---
# auto = Gemma through the Gemini API when a key is set, otherwise off.
# ollama = a local Gemma model served by Ollama (no key needed).
GEMMA_PROVIDER=auto
GEMMA_MODEL=gemma-4-26b-a4b-it
OLLAMA_URL=http://localhost:11434
OLLAMA_GEMMA_MODEL=gemma4

# --- Vertex AI instead of an API key (optional, for Google Cloud deployments) ---
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

# --- Simulator limits ---
MAX_QUBITS=128
SV_AUTO_MAX=20
SV_HARD_MAX=24
MAX_BOND_LIMIT=256
ARRAY_BACKEND=numpy
